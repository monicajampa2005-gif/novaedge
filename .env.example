# Copy this file to .env and fill in your values
PORT=3000

# Razorpay TEST keys (Dashboard -> Settings -> API Keys, in Test Mode)
RAZORPAY_KEY_ID=rzp_test_U2nm8s3ie8Htbo
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only needed if you configure a webhook in Razorpay dashboard
# Webhook URL: https://your-domain/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# Token to open /admin.html (leads & payments dashboard). Change this!
ADMIN_TOKEN=change-me-admin-token
